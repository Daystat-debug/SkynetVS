# ---- STT ----
STT_MODEL_SMALL=models/model_small
STT_MODEL_LARGE=models/model_large

# ---- Wake word / flow ----
HOTWORDS=скайнет,skynet
COMMAND_WINDOW_SEC=7.0
IGNORE_AFTER_TTS_SEC=1.0

# ---- NLU ----
NLU_ACCEPT_CONF=0.35
NLU_SAY_CONF=0.45

# ---- Audio ----
VOLUME_STEP=10

# ---- Whisper (держим выключенным) ----
WHISPER_ENABLE=0
WHISPER_MODEL=small
WHISPER_LANG=ru
WHISPER_TRIGGER_CONF=0.45

# TTS
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+0%
TTS_VOLUME=+20%
TTS_PITCH=+0Hz

# ---- Runtime health ----
RUNTIME_HEALTH_MONITOR_ENABLE=1
RUNTIME_HEALTH_MONITOR_INTERVAL_SEC=5.0
