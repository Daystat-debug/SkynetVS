+{
+  "schema": "SKYNETVS_DEVELOPMENT_LESSONS_V1",
+  "lessons": [
+    {
+      "id": "M154.static-is-not-full-check",
+      "status": "verified",
+      "scope": "Проверки DTR-B",
+      "tags": [
+        "dtr",
+        "dtr-b",
+        "dtrb",
+        "static",
+        "pipeline",
+        "проверка",
+        "статический"
+      ],
+      "paths": [
+        "modules/developer/developer_task_rehearsal.py",
+        "modules/developer/developer_task_rehearsal_contract.py",
+        "tools/pipeline.py"
+      ],
+      "symptom": "Успешный статический прогон можно ошибочно принять за завершение всех проверок исправления.",
+      "cause": "Контракт успеха static DTR-B специально оставляет pipeline(flow=check) в pending и all_required_checks_passed=false.",
+      "prevention": "Сохранять отдельные статусы static, исполняющего pipeline и применения изменения. При static PASS не объявлять поведение проверенным или patch применённым.",
+      "evidence": [
+        "https://github.com/Daystat-debug/SkynetVS/blob/3cd5a06b3b17ce2e6b9b25351a1b455289974dfb/modules/developer/developer_task_rehearsal_contract.py#L138-L146",
+        "https://github.com/Daystat-debug/SkynetVS/blob/8b737a94b5c9315a187d2de527948cf331c84cc2/reports/M154/a743e3a6ac074f558d0ccc545602f074/summary.json"
+      ],
+      "regression_check": "Проверить, что receipt статического успеха сохраняет pending pipeline и не получает статус полного PASS."
+    },
+    {
+      "id": "M154.keep-report-git-independent",
+      "status": "verified",
+      "scope": "Передача результатов через Git",
+      "tags": [
+        "git",
+        "reports",
+        "report",
+        "commit",
+        "fingerprint",
+        "отчёт",
+        "отчеты",
+        "публикация"
+      ],
+      "paths": [
+        "modules/developer/developer_task_preflight.py",
+        "modules/developer/developer_task_workspace_source.py",
+        "tools/m154_workflow/"
+      ],
+      "symptom": "Запись отчёта в проверяемый working tree или новый commit меняет состояние, к которому был привязан DTR-запрос.",
+      "cause": "Preflight требует exact HEAD==base_commit и чистое дерево; source fingerprint включает также refs, index и config.",
+      "prevention": "Публиковать результаты через независимую Git-копию и reports/m154; кандидат эксперимента хранить отдельно. В каждом отчёте указывать base и фактически проверенный candidate commit.",
+      "evidence": [
+        "https://github.com/Daystat-debug/SkynetVS/blob/3cd5a06b3b17ce2e6b9b25351a1b455289974dfb/modules/developer/developer_task_preflight.py#L523-L580",
+        "https://github.com/Daystat-debug/SkynetVS/blob/3cd5a06b3b17ce2e6b9b25351a1b455289974dfb/modules/developer/developer_task_workspace_source.py#L33-L46"
+      ],
+      "regression_check": "Сопоставить HEAD/status/refs/index/config исходной копии до и после публикации."
+    },
