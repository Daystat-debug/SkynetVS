{
  "kind": "SCM01_WSB01_BENIGN_PROTOCOL_V1",
  "policy": {
    "profile": "SCM01-WSB01-BEN01",
    "backend": "traditional_wsb_logoncommand_v1",
    "guest_identity": "existing WDAGUtilityAccount; no SYSTEM task/account/ACL mutation",
    "host_processes": {
      "supervisor": 1,
      "artifact_worker": 1,
      "worker_job_active_process_limit": 1,
      "worker_creation_flags": [
        "CREATE_SUSPENDED",
        "DETACHED_PROCESS",
        "CREATE_UNICODE_ENVIRONMENT"
      ],
      "sandbox_in_worker_job": false,
      "launch_budget": 1
    },
    "retirement": {
      "basis": "EXCLUSIVE_HOST_KNOWN_PROCESSSET_V1",
      "hypervisor_disposal_proven": false,
      "same_user_host_adversary_protection": false,
      "requires_exclusive_operator_session": true,
      "required_empty_complete_scans": 3,
      "minimum_scan_spacing_ms": 250,
      "foreign_pid_cleanup": false,
      "force_implies_failure": true
    },
    "budgets": {
      "ready_seconds": 120,
      "guest_authorization_seconds": 90,
      "terminal_after_publication_seconds": 60,
      "shutdown_grace_seconds": 45,
      "host_absolute_seconds": 300,
      "cleanup_seconds": 10
    },
    "limits": {
      "request": 32768,
      "ready": 65536,
      "authorization": 16384,
      "completion_marker": 4096,
      "journal": 65536,
      "journal_records": 16,
      "record": 8192,
      "terminal": 65536,
      "failure": 16384,
      "signature": 64,
      "accepted_raw_snapshot": 262144
    },
    "required_output": [
      "ready.json",
      "ready.sig",
      "ready.commit.json",
      "journal.jsonl",
      "terminal.json",
      "terminal.sig",
      "terminal.commit.json"
    ],
    "optional_failure": "failure.json",
    "real_scm_budget": 0,
    "guard_payload": null,
    "disk_quota_claimed": false
  },
  "wire": {
    "constant_fields": {
      "schema": "SKYNETVS_SCM01_WSB01_BENIGN_V1",
      "version": 1,
      "profile": "SCM01-WSB01",
      "experiment": "SCM01-WSB01-BEN01",
      "evidence_domain": "BENIGN_SANDBOX_LAB",
      "scenario": "fixed_digest_roundtrip",
      "guard": null
    },
    "message_fields": {
      "request": [
        "capsule_sha256",
