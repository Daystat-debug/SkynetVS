      ],
      "terminal": [
        "authorization_commit_sha256",
        "authorization_sha256",
        "capsule_sha256",
        "evidence_domain",
        "experiment",
        "journal_bytes",
        "journal_records",
        "journal_sha256",
        "kind",
        "layout_sha256",
