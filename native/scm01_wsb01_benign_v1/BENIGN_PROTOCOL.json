      ],
      "failure": [
        "code",
        "evidence_domain",
        "experiment",
        "kind",
        "message",
        "nonce",
        "profile",
        "run_id",
        "schema",
        "version"
      ]
    },
    "scalar_rules": {
      "ids": "run_id/grant_id 32 lowercase hex; nonce 64 lowercase hex",
      "sha256": "64 lowercase hex",
      "version": "exact int 1, not bool",
      "counts": "uint64 integers unless smaller explicit bound; not bool",
      "public_key_blob_hex": "144 lowercase hex chars: 72-byte CNG P256 public blob",
      "floats": "forbidden",
      "unknown_fields": "forbidden",
      "duplicate_keys": "forbidden"
    },
    "encoding": "ensure_ascii=True; recursive sort_keys=True; compact; exactly one LF; strict bounded parser",
    "scm_budget_fields": {
      "create": 0,
      "start": 0,
      "delete": 0,
      "control_service": 0,
      "manual_guard_spawn": 0
    },
    "guest_runtime_fields": [
      "major",
      "minor",
      "micro",
      "pointer_bits",
      "isolated",
      "no_site",
      "dont_write_bytecode"
    ],
    "guest_runtime_evidence_warning": "Self-report compared against fixed runtime descriptor; not independent OS provenance or host Python equality",
    "journal_events": {
      "BEGIN": [],
      "AUTHORIZATION_OBSERVED": [
        "authorization_sha256",
        "authorization_commit_sha256"
      ],
      "BENIGN_COMPLETED": [
        "response_sha256"
      ],
      "FINAL": [
        "result"
      ],
      "ERROR": [
        "code"
      ]
    },
    "journal_success_order": [
      "BEGIN",
      "AUTHORIZATION_OBSERVED",
      "BENIGN_COMPLETED",
      "FINAL"
    ],
    "journal_success_result": "BENIGN_TASK_COMPLETED",
    "journal_failure_result": "BENIGN_TASK_FAILED",
    "shutdown": "Bootstrap requests one fixed shutdown only after guest interpreter returns; terminal/journal do not falsely attest shutdown requested or VM disposal. Host observes retirement independently.",
    "hash_scopes": {
      "policy_sha256": "SHA256(canonical static policy object), no embedded computed policy hash",
      "schema_sha256": "SHA256(canonical static wire descriptor), no embedded computed schema hash",
      "source_sha256": "SHA256(canonical sorted executable-source manifest for .py/.ps1 files only); excludes metadata manifests to avoid self-reference",
      "capsule_sha256": "SHA256(canonical sorted exact guest-code member manifest); excludes manifest itself and run/request data",
      "runtime_sha256": "SHA256(pinned retained runtime content manifest); fixed runtime identities not guessed from version",
      "layout_sha256": "SHA256(canonical role paths/settings/config hash descriptor); wsb config excludes request hash",
      "response_sha256": "SHA256(fixed roundtrip domain bytes + exact request bytes)"
    },
    "signature": {
      "algorithm": "ECDSA_P256_SHA256_CNG",
      "ready_domain": "SKYNETVS/SCM01-WSB01/BENIGN_SANDBOX_LAB/READY/V1\u0000",
      "terminal_domain": "SKYNETVS/SCM01-WSB01/BENIGN_SANDBOX_LAB/TERMINAL/V1\u0000",
      "api_input": "SHA256(domain_bytes + exact_payload_bytes), one prehash",
      "public_blob_bytes": 72,
      "raw_signature_bytes": 64,
      "host_verdict_requires_real_provider": true
    }
  }
}
