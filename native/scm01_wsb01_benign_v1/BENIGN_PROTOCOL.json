      ],
      "authorization": [
        "evidence_domain",
        "experiment",
        "grant_id",
        "kind",
        "nonce",
        "profile",
        "public_key_sha256",
        "ready_sha256",
        "ready_signature_sha256",
        "request_sha256",
        "run_id",
        "scenario",
        "schema",
        "scm_budget",
        "session_binding_sha256",
        "version"
      ],
      "authorization_commit": [
        "authorization_sha256",
        "evidence_domain",
        "experiment",
        "kind",
        "nonce",
        "profile",
        "run_id",
        "schema",
        "version"
      ],
      "journal_record": [
        "data",
        "event",
        "evidence_domain",
